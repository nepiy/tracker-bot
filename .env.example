NODE_ENV=development
LOG_LEVEL=info

TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENSEA_API_KEY=

ETHEREUM_RPC_URL=
BASE_RPC_URL=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# JSON arrays. Add any EVM RPCs to monitor the inferred dev address cross-chain.
MONITORING_CHAINS_JSON=[]
# Verified exchange deposit/hot-wallet addresses: [{"chainId":1,"address":"0x...","exchange":"Binance"}]
CEX_ADDRESSES_JSON=[]

WATCHER_POLL_INTERVAL_MS=12000
WATCHER_BOOTSTRAP_LOOKBACK_BLOCKS=10
WATCHER_MAX_BACKLOG_BLOCKS=5000
WATCHER_SCAN_BATCH_SIZE=250
WATCHER_BLOCK_FETCH_CONCURRENCY=16
WATCHER_CONFIRMATIONS=1
# OpenSea upcoming-drop scan interval (minimum 60000 ms).
FREE_MINT_POLL_INTERVAL_MS=600000
# OpenSea collection floor scan interval for one-time user price targets (minimum 30000 ms).
PRICE_ALERT_POLL_INTERVAL_MS=60000
# Durable Telegram alert delivery queue interval (minimum 1000 ms).
TELEGRAM_OUTBOX_POLL_INTERVAL_MS=5000
TELEGRAM_RATE_LIMIT_PER_MINUTE=8
