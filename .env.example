NODE_ENV=development
LOG_LEVEL=info

TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
# Recommended modern backend key (sb_secret_...). Keep it server-side only.
SUPABASE_SECRET_KEY=
# Legacy fallback. Do not set both unless you are migrating keys.
SUPABASE_SERVICE_ROLE_KEY=
OPENSEA_API_KEY=

ETHEREUM_RPC_URL=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# JSON arrays. Optional extra chains are used for creator-token history lookups, not wallet/dev alerts.
MONITORING_CHAINS_JSON=[]
# Verified exchange deposit/hot-wallet addresses: [{"chainId":1,"address":"0x...","exchange":"Binance"}]
CEX_ADDRESSES_JSON=[]

WATCHER_POLL_INTERVAL_MS=12000
WATCHER_BOOTSTRAP_LOOKBACK_BLOCKS=10
WATCHER_MAX_BACKLOG_BLOCKS=5000
WATCHER_SCAN_BATCH_SIZE=250
WATCHER_BLOCK_FETCH_CONCURRENCY=16
WATCHER_CONFIRMATIONS=1
# Independent newest-block scan for low-latency alerts while the main cursor backfills.
WATCHER_LIVE_POLL_INTERVAL_MS=2000
WATCHER_LIVE_LOOKBACK_BLOCKS=100
# Wider one-time replay when a direct-wallet subscription is added or removed.
WATCHER_SUBSCRIPTION_REPLAY_BLOCKS=1000
# Recheck the recent live window periodically; database/outbox keys suppress duplicates.
WATCHER_RECONCILE_INTERVAL_MS=30000
# Minimum spacing between marketplace eth_getLogs calls per chain (limits RPC bursts).
WATCHER_MARKETPLACE_LOG_QUERY_INTERVAL_MS=125
# OpenSea free-mint lookahead window in hours (1-24).
FREE_MINT_LOOKAHEAD_HOURS=1
# OpenSea upcoming-drop scan interval (minimum 60000 ms).
FREE_MINT_POLL_INTERVAL_MS=600000
# OpenSea collection floor scan interval for one-time user price targets (minimum 30000 ms).
PRICE_ALERT_POLL_INTERVAL_MS=60000
TELEGRAM_RATE_LIMIT_PER_MINUTE=8
# Shared bot-wide ceiling that protects third-party APIs from multi-account bursts.
TELEGRAM_GLOBAL_RATE_LIMIT_PER_MINUTE=240
# Maximum updates executing handlers at the same time.
TELEGRAM_MAX_CONCURRENT_UPDATES=20
