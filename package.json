{
  "name": "opensea-dev-wallet-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot that tracks outgoing activity from likely NFT collection team wallets.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:bot": "tsx watch src/bot/run.ts",
    "dev:watcher": "tsx watch src/watcher/run.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:bot": "node dist/bot/run.js",
    "start:watcher": "node dist/watcher/run.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2",
    "dotenv": "17.2.3",
    "grammy": "1.45.1",
    "pino": "10.3.1",
    "viem": "2.55.11",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "supabase": "2.113.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
